# ==========================================
# NESTJS - ENV CONFIG
# ==========================================
# To create secret using open SSL:
# openssl rand -base64 32 or openssl rand -hex 32

# ===== Application =====
PORT=7000
NODE_ENV=development
# The BFF forwards the resolved client IP to this private service. Keep the
# auth service reachable only by trusted BFFs when trusting this one hop.
TRUST_PROXY_HOPS=1

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=root
DB_NAME=meal_guides_auth_db
DB_SSL=false

# ===== Redis Cache =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===== CORS Configuration =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

AUTH_INTERNAL_API_KEYS={"app-1":"replace-with-app-1-bff-key","app-2":"replace-with-app-2-bff-key"}